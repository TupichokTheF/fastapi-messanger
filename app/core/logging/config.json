{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "base_format": {
      "format": "%(levelname)s: [%(funcName)s] %(message)s"
    }
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "base_format",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "chat_app": {
      "level": "INFO",
      "handlers": [
        "stdout"
      ]
    }
  }
}